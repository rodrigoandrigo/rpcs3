; Internal arithmetic contract probe, independent of extension advertising.
; Each invocation checks SRem and SMod with runtime operands of both signs.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %data
OpExecutionMode %main LocalSize 32 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %array ArrayStride 4
OpDecorate %block Block
OpMemberDecorate %block 0 Offset 0
OpDecorate %data DescriptorSet 0
OpDecorate %data Binding 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%uint = OpTypeInt 32 0
%int = OpTypeInt 32 1
%bool = OpTypeBool
%v3uint = OpTypeVector %uint 3
%input = OpTypePointer Input %v3uint
%gid = OpVariable %input Input
%array = OpTypeRuntimeArray %uint
%block = OpTypeStruct %array
%storage = OpTypePointer StorageBuffer %block
%data = OpVariable %storage StorageBuffer
%ptr = OpTypePointer StorageBuffer %uint
%u0 = OpConstant %uint 0
%u1 = OpConstant %uint 1
%u2 = OpConstant %uint 2
%u5 = OpConstant %uint 5
%u15 = OpConstant %uint 15
%magic = OpConstant %uint 610795520
%i0 = OpConstant %int 0
%i7 = OpConstant %int 7
%main = OpFunction %void None %fn
%entry = OpLabel
%ids = OpLoad %v3uint %gid
%id = OpCompositeExtract %uint %ids 0
%a0 = OpUMod %uint %id %u15
%ai = OpBitcast %int %a0
%a = OpISub %int %ai %i7
%b0 = OpUMod %uint %id %u5
%b1 = OpIAdd %uint %b0 %u2
%bi = OpBitcast %int %b1
%bit = OpBitwiseAnd %uint %id %u1
%negative = OpINotEqual %bool %bit %u0
%nb = OpSNegate %int %bi
%b = OpSelect %int %negative %nb %bi
%quotient = OpSDiv %int %a %b
%product = OpIMul %int %quotient %b
%expected_rem = OpISub %int %a %product
%ab = OpBitwiseXor %int %a %b
%opposite = OpSLessThan %bool %ab %i0
%nonzero = OpINotEqual %bool %expected_rem %i0
%correct = OpLogicalAnd %bool %opposite %nonzero
%adjusted = OpIAdd %int %expected_rem %b
%expected_mod = OpSelect %int %correct %adjusted %expected_rem
%rem = OpSRem %int %a %b
%mod = OpSMod %int %a %b
%rem_ok = OpIEqual %bool %rem %expected_rem
%mod_ok = OpIEqual %bool %mod %expected_mod
%ok = OpLogicalAnd %bool %rem_ok %mod_ok
%value = OpIAdd %uint %magic %id
%result = OpSelect %uint %ok %value %u0
%address = OpAccessChain %ptr %data %u0 %id
OpStore %address %result
OpReturn
OpFunctionEnd
