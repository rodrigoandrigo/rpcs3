; Focused alias/subword/ALU test, not Vulkan CTS. SPDX-License-Identifier: MIT
OpCapability Shader
OpCapability Int8
OpCapability Int16
OpCapability Float16
OpCapability WorkgroupMemoryExplicitLayoutKHR
OpCapability WorkgroupMemoryExplicitLayout8BitAccessKHR
OpCapability WorkgroupMemoryExplicitLayout16BitAccessKHR
OpExtension "SPV_KHR_workgroup_memory_explicit_layout"
OpExtension "SPV_KHR_zero_initialize_workgroup_memory"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %lid %output %words %bytes %halves
OpExecutionMode %main LocalSize 32 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %lid BuiltIn LocalInvocationId
OpDecorate %out_array ArrayStride 4
OpDecorate %Out Block
OpMemberDecorate %Out 0 Offset 0
OpDecorate %output DescriptorSet 0
OpDecorate %output Binding 0
OpDecorate %word_array ArrayStride 4
OpDecorate %byte_array ArrayStride 1
OpDecorate %half_array ArrayStride 2
OpDecorate %WordBlock Block
OpDecorate %ByteBlock Block
OpDecorate %HalfBlock Block
OpMemberDecorate %WordBlock 0 Offset 0
OpMemberDecorate %ByteBlock 0 Offset 0
OpMemberDecorate %HalfBlock 0 Offset 0
OpDecorate %words Aliased
OpDecorate %bytes Aliased
OpDecorate %halves Aliased
%void = OpTypeVoid
%fn = OpTypeFunction %void
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%u8 = OpTypeInt 8 0
%u16 = OpTypeInt 16 0
%f16 = OpTypeFloat 16
%f32 = OpTypeFloat 32
%v3u32 = OpTypeVector %u32 3
%in_v3 = OpTypePointer Input %v3u32
%gid = OpVariable %in_v3 Input
%lid = OpVariable %in_v3 Input
%zero = OpConstant %u32 0
%one = OpConstant %u32 1
%two = OpConstant %u32 2
%four = OpConstant %u32 4
%n32 = OpConstant %u32 32
%n64 = OpConstant %u32 64
%n128 = OpConstant %u32 128
%semantics = OpConstant %u32 264
%base = OpConstant %u32 610795520
%error = OpConstant %u32 3735928559
%u8_one = OpConstant %u8 1
%u8_ff = OpConstant %u8 255
%half_bias = OpConstant %f16 1.5
%float_bias = OpConstant %f32 1.5
%out_array = OpTypeRuntimeArray %u32
%Out = OpTypeStruct %out_array
%out_ptr = OpTypePointer StorageBuffer %Out
%out_u32_ptr = OpTypePointer StorageBuffer %u32
%output = OpVariable %out_ptr StorageBuffer
%word_array = OpTypeArray %u32 %n32
%byte_array = OpTypeArray %u8 %n128
%half_array = OpTypeArray %u16 %n64
%WordBlock = OpTypeStruct %word_array
%ByteBlock = OpTypeStruct %byte_array
%HalfBlock = OpTypeStruct %half_array
%word_block_ptr = OpTypePointer Workgroup %WordBlock
%byte_block_ptr = OpTypePointer Workgroup %ByteBlock
%half_block_ptr = OpTypePointer Workgroup %HalfBlock
%word_ptr = OpTypePointer Workgroup %u32
%byte_ptr = OpTypePointer Workgroup %u8
%half_ptr = OpTypePointer Workgroup %u16
%null_words = OpConstantNull %WordBlock
%words = OpVariable %word_block_ptr Workgroup %null_words
%bytes = OpVariable %byte_block_ptr Workgroup
%halves = OpVariable %half_block_ptr Workgroup
%main = OpFunction %void None %fn
%entry = OpLabel
%gvec = OpLoad %v3u32 %gid
%lvec = OpLoad %v3u32 %lid
%g = OpCompositeExtract %u32 %gvec 0
%l = OpCompositeExtract %u32 %lvec 0
%expected = OpIAdd %u32 %base %g
%wp = OpAccessChain %word_ptr %words %zero %l
%initial = OpLoad %u32 %wp
%zero_ok = OpIEqual %bool %initial %zero
OpStore %wp %expected
OpControlBarrier %two %two %semantics
%bi = OpIMul %u32 %l %four
%hi = OpIMul %u32 %l %two
%bp = OpAccessChain %byte_ptr %bytes %zero %bi
%hp = OpAccessChain %half_ptr %halves %zero %hi
%b = OpLoad %u8 %bp
%h = OpLoad %u16 %hp
%want8 = OpUConvert %u8 %expected
%want16 = OpUConvert %u16 %expected
%wrap = OpIAdd %u8 %want8 %u8_ff
%wrapped = OpIAdd %u8 %wrap %u8_one
%b_ok = OpIEqual %bool %b %wrapped
%h_ok = OpIEqual %bool %h %want16
%fl = OpConvertUToF %f16 %l
%fh = OpFAdd %f16 %fl %half_bias
%fwide = OpFConvert %f32 %fh
%flwide = OpConvertUToF %f32 %l
%fwant = OpFAdd %f32 %flwide %float_bias
%f_ok = OpFOrdEqual %bool %fwide %fwant
%small_ok = OpLogicalAnd %bool %b_ok %h_ok
%float_ok = OpLogicalAnd %bool %small_ok %f_ok
%ok = OpLogicalAnd %bool %float_ok %zero_ok
%value = OpSelect %u32 %ok %expected %error
%dst = OpAccessChain %out_u32_ptr %output %zero %g
OpStore %dst %value
OpReturn
OpFunctionEnd
