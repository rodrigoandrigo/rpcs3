#version 450
layout(local_size_x=32) in;
layout(set=0, binding=0, std430) buffer Output { uint values[]; } output_data;
shared uint scratch[32];
void main()
{
   uint index=gl_GlobalInvocationID.x;
   // The checked-in SPIR-V assembly adds the Workgroup OpConstantNull
   // initializer. Assemble that fixture for the probe; compiling this GLSL
   // alone does not test zero initialization.
   output_data.values[index]=0x24680000u+index+scratch[gl_LocalInvocationID.x];
}
