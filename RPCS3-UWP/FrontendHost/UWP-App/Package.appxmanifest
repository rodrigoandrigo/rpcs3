<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp rescap">
  <Identity
    Name="a27137f1-4f33-4945-bd29-8b25ee377cfa"
    Publisher="CN=rodri"
    Version="1.0.0.92" />
  <mp:PhoneIdentity
    PhoneProductId="c28d45f3-499d-4baa-882c-f1663523eb75"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>RPCS3 UWP</DisplayName>
    <PublisherDisplayName>rodri</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Universal"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily
      Name="Windows.Xbox"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      MinVersion="14.0.33519.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application
      Id="SampleApp"
      Executable="$targetnametoken$.exe"
      EntryPoint="UwpImGuiFrontend.XamlApp">
      <uap:VisualElements
        DisplayName="RPCS3 UWP"
        Description="RPCS3 PlayStation 3 emulator"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#202020" >
        <uap:DefaultTile Square71x71Logo="Assets\SmallTile.png" Wide310x150Logo="Assets\WideTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png"/>
        <uap:LockScreen BadgeLogo="Assets\BadgeLogo.png" Notification="badge"/>
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="broadFileSystemAccess" />
    <Capability Name="codeGeneration" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="removableStorage" />
    <Capability Name="internetClient"/>
  </Capabilities>
</Package>
